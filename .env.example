###############################################################################
##                     Docker Compose environment (.env)                     ##
###############################################################################
##
## Values here are interpolated into the compose files. There are NO secrets
## in this file: passwords, tokens and keys live in secrets/ and are mounted
## as Docker secrets (see scripts/env-to-secret.sh to move one there).
##
## Everything personal or site-specific is in the SITE block directly below,
## so it's the only part to change or redact (.env.example has it blanked).
##
## Style: one section per service, alphabetical, headed
##   ###NAME### https://link-to-project
## Values in double quotes; comments on their own line, not after a value.

###SITE###
DOMAINNAME="CHANGE_ME"
DOMAINNAME2="CHANGE_ME"
LLDAP__LDAP_BASE_DN="CHANGE_ME"
DATADIR="CHANGE_ME"
POSTGRESQL__USER="CHANGE_ME"
SMTP__HOST="CHANGE_ME"
SMTP__USERNAME="CHANGE_ME"
GHOST__MAIL_FROM="CHANGE_ME"
VPN__SERVICE_PROVIDER="CHANGE_ME"
VPN__SERVER_COUNTRIES="CHANGE_ME"
# Port forwarded by the VPN provider (MAM connectability).
TORRENTING_PORT="CHANGE_ME"

###GLOBAL###
PUID="1000"
PGID="1000"
TZ="Europe/London"
LOG_LEVEL="info"

###PATHS###
DOCKERDIR="/opt/docker/"
VOLDIR="/var/lib/docker/volumes"

###DOCKER###
# Traefik, Dozzle, Diun and Mousetrap use the read-only proxy; deunhealth the
# other (which only adds container restarts).
DOCKER_HOST="tcp://socket-proxy:2375"
DOCKER_HOST_RO="tcp://socket-proxy-ro:2375"
SUBNET_EXTERNAL="172.20.0.0/16"
SUBNET_SOCKET_PROXY_RO="172.21.1.0/24"

###SMTP###
SMTP__PASSWORD="/run/secrets/smtp_password"
SMTP__PORT="465"
SMTP__SECURITY="force_tls"
SMTP__USE_SSL="true"
SMTP__TIMEOUT="15"
EMAIL_ADMIN="admin@${DOMAINNAME}"


###AUDIOBOOKSHELF### https://github.com/advplyr/audiobookshelf
# (disabled in compose.yaml) Pin a real version before re-enabling.
AUDIOBOOKSHELF__NAME="audiobookshelf"
AUDIOBOOKSHELF__SUBDOMAIN="${AUDIOBOOKSHELF__NAME}"
# Data folder (its name differs from the container's).
AUDIOBOOKSHELF__VOLDIR="${VOLDIR}/abs"
AUDIOBOOKSHELF__IMAGE="ghcr.io/advplyr/audiobookshelf"
AUDIOBOOKSHELF__VERSION="latest"

###AUTHELIA### https://github.com/authelia/authelia
AUTHELIA__NAME="authelia"
AUTHELIA__SUBDOMAIN="authelia"
AUTHELIA__IMAGE="docker.io/authelia/authelia"
AUTHELIA__VERSION="4.39.20"
AUTHELIA__JWT_SECRET="/run/secrets/authelia_jwt_secret"
AUTHELIA__SESSION_SECRET="/run/secrets/authelia_session_secret"
# Session store (compose/authelia-redis). HOST is its service key.
AUTHELIA__REDIS_NAME="authelia-redis"
AUTHELIA__SESSION_REDIS_HOST="authelia-redis"
AUTHELIA__SESSION_REDIS_PORT="6379"
AUTHELIA__SESSION_REDIS_PASSWORD="/run/secrets/authelia_redis_password"
AUTHELIA__STORAGE_PASSWORD="/run/secrets/authelia_db_password"
AUTHELIA__STORAGE_ENCRYPTION_KEY="/run/secrets/authelia_storage_encryption_key"
AUTHELIA__IDENTITY_HMAC_SECRET="/run/secrets/authelia_oidc_hmac_secret"
AUTHELIA__DB_NAME="authelia"
AUTHELIA__DB_USERNAME="authelia"
AUTHELIA__NOTIFIER_SMTP_ADDRESS="submissions://${SMTP__HOST}:${SMTP__PORT}"
AUTHELIA__NOTIFIER_SMTP_SENDER="Authelia <authelia@${DOMAINNAME}>"
AUTHELIA__NOTIFIER_SMTP_SUBJECT="SabNet-Auth"
AUTHELIA__AUTHENTICATION_BACKEND_LDAP_IMPLEMENTATION="lldap"
AUTHELIA__AUTHENTICATION_BACKEND_LDAP_USER="uid=authelia,ou=people,${LLDAP__LDAP_BASE_DN}"
AUTHELIA__AUTHENTICATION_BACKEND_LDAP_PASSWORD_FILE="/run/secrets/authelia_ldap_password"
# access_control.default_policy is 'deny' in configuration.yml; don't set it here.

###BOOKKEEP### https://github.com/bookkeepapp/bookkeep
# (disabled in compose.yaml) Before re-enabling: its secret key, Hardcover API
# token and database URL must go into secrets/ (they used to sit here), and it
# needs a Redis it can reach. Pin a real version too.
BOOKKEEP__NAME="bookkeep"
BOOKKEEP__SUBDOMAIN="${BOOKKEEP__NAME}"
BOOKKEEP__IMAGE="akiraslingshot/bookkeep"
BOOKKEEP__VERSION="latest"
BOOKKEEP__REDIS_URL="redis://redis:6379/0"

###CHAPTARR### https://hub.docker.com/r/chaptarr/chaptarr
CHAPTARR__NAME="chaptarr"
CHAPTARR__SUBDOMAIN="${CHAPTARR__NAME}"
CHAPTARR__IMAGE="chaptarr/chaptarr"
# Only publishes :latest with no app version label; Diun watches its digest.
CHAPTARR__VERSION="latest"
CHAPTARR__DB_USER="chaptarr"
CHAPTARR__DB_PORT="5432"

###CLOUDFLARED### https://github.com/cloudflare/cloudflared
CLOUDFLARED__NAME="cloudflared"
CLOUDFLARED__IMAGE="cloudflare/cloudflared"
CLOUDFLARED__VERSION="2026.6.0"
CLOUDFLARED__TUNNEL_TOKEN_FILE="/run/secrets/cloudflared_tunnel_token"

###COUCHDB### https://github.com/apache/couchdb
COUCHDB__NAME="couchdb"
COUCHDB__SUBDOMAIN="couch"
# Data folder (its name differs from the container's).
COUCHDB__VOLDIR="${VOLDIR}/couch"
COUCHDB__IMAGE="couchdb"
COUCHDB__VERSION="3.5.2"

###CROSSWATCH### https://github.com/cenodude/crosswatch
CROSSWATCH__NAME="crosswatch"
# At <subdomain>.int.<domain>
CROSSWATCH__SUBDOMAIN="${CROSSWATCH__NAME}"
CROSSWATCH__IMAGE="ghcr.io/cenodude/crosswatch"
CROSSWATCH__VERSION="0.13.3"

###DEUNHEALTH### https://github.com/qdm12/deunhealth
DEUNHEALTH__NAME="deunhealth"
DEUNHEALTH__IMAGE="qmcgaw/deunhealth"
DEUNHEALTH__VERSION="v0.3.0"

###DIUN### https://github.com/crazy-max/diun
# Emails when newer image versions exist; nothing updates automatically.
DIUN__NAME="diun"
DIUN__IMAGE="crazymax/diun"
DIUN__VERSION="4.33.0"
# Cron: every 6 hours
DIUN__SCHEDULE="0 */6 * * *"
# Bare address only; Diun rejects the "Name <address>" form.
DIUN__MAIL_FROM="diun@${DOMAINNAME}"

###DOZZLE### https://github.com/amir20/dozzle
DOZZLE__NAME="dozzle"
DOZZLE__SUBDOMAIN="dozzle"
DOZZLE__IMAGE="amir20/dozzle"
DOZZLE__VERSION="v10.6.15"

###FILEBROWSER### https://github.com/gtsteffaniak/filebrowser
FILEBROWSER__NAME="filebrowser"
FILEBROWSER__SUBDOMAIN="files"
FILEBROWSER__IMAGE="gtstef/filebrowser"
FILEBROWSER__VERSION="1.5.8-stable"
FILEBROWSER__DATABASE_PATH="/home/filebrowser/data"
FILEBROWSER__DATABASE="${FILEBROWSER__DATABASE_PATH}/database.db"

###FRESHRSS### https://github.com/FreshRSS/FreshRSS
FRESHRSS__NAME="freshrss"
FRESHRSS__SUBDOMAIN="rss"
# Data folder (its name differs from the container's).
FRESHRSS__VOLDIR="${VOLDIR}/fresh-rss"
FRESHRSS__IMAGE="freshrss/freshrss"
FRESHRSS__VERSION="1.29.1"
FRESHRSS__DB_NAME="freshrss"
FRESHRSS__DB_USER="freshrss"
FRESHRSS__DB_PASSWORD_FILE="file:///run/secrets/freshrss_db_password"
FRESHRSS__CRON_MIN="3,33"
# 0: log in from Authelia's Remote-User header (trusted only from Traefik,
# TRUSTED_PROXY in fresh-rss.yaml). 1: a second login via OIDC.
FRESHRSS__OIDC_ENABLED="0"
FRESHRSS__OIDC_PROVIDER_METADATA_URL="https://${AUTHELIA__SUBDOMAIN}.${DOMAINNAME}/.well-known/openid-configuration"
FRESHRSS__OIDC_X_FORWARDED_HEADERS="X-Forwarded-Port X-Forwarded-Proto X-Forwarded-Host"
FRESHRSS__OIDC_SCOPES="openid groups email profile"

###GHOST### https://github.com/TryGhost/Ghost
GHOST__NAME="ghost"
GHOST__IMAGE="ghost"
GHOST__VERSION="6.69.0-alpine"
# Public blog on the second domain (no Authelia).
GHOST__SUBDOMAIN="blog"
GHOST__DOMAIN="${GHOST__SUBDOMAIN}.${DOMAINNAME2}"
GHOST__MAIL_TRANSPORT="SMTP"
GHOST__UPLOAD_LOCATION="${VOLDIR}/ghost/data"
# Database settings must not change once the database is initialised.
GHOST__DATABASE_NAME="ghost-db"
GHOST__DATABASE_IMAGE="mysql"
GHOST__DATABASE_VERSION="8.0.44@sha256:f37951fc3753a6a22d6c7bf6978c5e5fefcf6f31814d98c582524f98eae52b21"
GHOST__DATABASE_USERNAME="ghost"
GHOST__MYSQL_DATA_LOCATION="${VOLDIR}/ghost/mysql"
GHOST__MYSQL_INIT_LOCATION="${VOLDIR}/ghost/.initsql"

###GRIMMORY### https://hub.docker.com/r/grimmory/grimmory
GRIMMORY__NAME="grimmory"
GRIMMORY__SUBDOMAIN="${GRIMMORY__NAME}"
GRIMMORY__IMAGE="grimmory/grimmory"
GRIMMORY__VERSION="v3.5.0"
GRIMMORY__PORT="6060"
GRIMMORY__DB_URL="jdbc:mariadb://mariadb:3306/booklore"
GRIMMORY__DB_NAME="booklore"
GRIMMORY__DB_USER="booklore"
# Grimmory's database container (GRIMMORY__DB_URL uses its service key, mariadb)
GRIMMORY__DB_CONTAINER="grimmory-mariadb"
GRIMMORY__DB_IMAGE="lscr.io/linuxserver/mariadb"
GRIMMORY__DB_VERSION="11.4.5"

###HOMEASSISTANT### https://github.com/home-assistant/core
HOMEASSISTANT__NAME="homeassistant"
HOMEASSISTANT__SUBDOMAIN="ha"
# Config folder (its name differs from the container's).
HOMEASSISTANT__VOLDIR="${VOLDIR}/home-assistant"
HOMEASSISTANT__IMAGE="ghcr.io/home-assistant/home-assistant"
HOMEASSISTANT__VERSION="2026.10.0"

###IMMICH### https://github.com/immich-app/immich
IMMICH__NAME="immich_server"
IMMICH__SUBDOMAIN="photos"
IMMICH__IMAGE="ghcr.io/immich-app/immich-server"
# Server and machine-learning versions must always match.
IMMICH__VERSION="v3.3.1"
IMMICH__DB_USERNAME="immich"
IMMICH__DB_DATABASE_NAME="immich"
IMMICH__DB_PASSWORD_FILE="/run/secrets/immich_db_password"
IMMICH__UPLOAD_LOCATION="${DATADIR}/immich/library"
IMMICH_ML__NAME="immich_machine_learning"
IMMICH_ML__IMAGE="ghcr.io/immich-app/immich-machine-learning"
# Follows the server version (they must match); only the suffix is set here.
IMMICH_ML__VERSION="${IMMICH__VERSION}-openvino"
IMMICH_ML__CACHE_DIR="${VOLDIR}/immich/model-cache"

###IRC### https://github.com/thelounge/thelounge-docker
IRC__NAME="thelounge"
# At <subdomain>.int.<domain>
IRC__SUBDOMAIN="irc"
# Data folder (its name differs from the container's).
IRC__VOLDIR="${VOLDIR}/irc"
IRC__IMAGE="ghcr.io/thelounge/thelounge"
IRC__VERSION="4.5.0"

###LEANTIME### https://github.com/Leantime/leantime
LEAN__NAME="leantime"
LEAN__SUBDOMAIN="lean"
LEAN__IMAGE="leantime/leantime"
LEAN__VERSION="3.10.4"
# Leantime's database container
LEAN__DB_CONTAINER="leantime-mysql"
LEAN__DB_IMAGE="mysql"
LEAN__DB_VERSION="8.4.11"
LEAN__PORT="8080"
# Base URL (with https://) for subfolder/proxy installs; empty = auto.
LEAN__APP_URL=""
# Base path without trailing slash, e.g. /leantime; empty = root.
LEAN__APP_DIR=""
LEAN__VOLUME_DIRECTORY="${VOLDIR}/leantime"
LEAN__SITENAME="Leantime"
LEAN__LANGUAGE="en-UK"
LEAN__DEFAULT_TIMEZONE="Europe/London"
# Empty = /logs/error.log
LEAN__LOG_PATH=""
LEAN__USER_FILE_PATH="userfiles/"
LEAN__DB_BACKUP_PATH="backupdb/"
# Database: MYSQL_* are for the leantime-mysql container, DB_* for the app;
# user and database name must match.
LEAN__MYSQL_DATABASE="leantime"
LEAN__MYSQL_USER="lean"
LEAN__DB_HOST="${LEAN__DB_CONTAINER}"
LEAN__DB_USER="lean"
LEAN__DB_DATABASE="leantime"
LEAN__DB_PORT="3306"
# Seconds of inactivity before logout (28800 = 8 hours)
LEAN__SESSION_EXPIRATION="28800"
LEAN__SESSION_SECURE="true"
# SSO only: hide the username/password form.
LEAN__DISABLE_LOGIN_FORM="true"
LEAN__OIDC_ENABLE="true"
LEAN__OIDC_PROVIDER_URL="https://${AUTHELIA__SUBDOMAIN}.${DOMAINNAME}"
LEAN__OIDC_CREATE_USER="true"
# 20 = editor
LEAN__OIDC_DEFAULT_ROLE="20"
LEAN__USE_REDIS="false"
# Email (password: secrets/smtp/password)
LEAN__EMAIL_RETURN="${LEAN__NAME}@${DOMAINNAME}"
LEAN__EMAIL_USE_SMTP="true"
LEAN__EMAIL_SMTP_AUTH="true"
LEAN__EMAIL_SMTP_AUTO_TLS="true"
LEAN__EMAIL_SMTP_SECURE="TLS"
# Role for users from LDAP (20 = editor; LDAP isn't used here)
LEAN__LDAP_DEFAULT_ROLE_KEY="20"
LEAN__RATELIMIT_GENERAL="1000"
LEAN__RATELIMIT_API="10"
LEAN__RATELIMIT_AUTH="20"

###LINKWARDEN### https://github.com/linkwarden/linkwarden
# Registration and password login are set in linkwarden.yaml (SSO only).
LINKWARDEN__NAME="linkwarden"
LINKWARDEN__SUBDOMAIN="bookmark"
LINKWARDEN__IMAGE="ghcr.io/linkwarden/linkwarden"
LINKWARDEN__VERSION="v2.16.3"
LINKWARDEN__NEXTAUTH_URL="https://${LINKWARDEN__SUBDOMAIN}.${DOMAINNAME}/api/v1/auth"
LINKWARDEN__NEXT_PUBLIC_AUTHELIA_ENABLED="true"
LINKWARDEN__AUTHELIA_WELLKNOWN_URL="https://${AUTHELIA__SUBDOMAIN}.${DOMAINNAME}/.well-known/openid-configuration"

###LLDAP### https://github.com/lldap/lldap
LLDAP__NAME="lldap"
LLDAP__SUBDOMAIN="lldap"
LLDAP__IMAGE="lldap/lldap"
LLDAP__VERSION="v0.6.3-alpine"
LLDAP__LDAP_URL="ldap://lldap:3890"
# Used in password-reset email links.
LLDAP__HTTP_URL="https://${LLDAP__SUBDOMAIN}.int.${DOMAINNAME}"
LLDAP__JWT_SECRET="/run/secrets/lldap_jwt_secret"
LLDAP__KEY_SEED="/run/secrets/lldap_key_seed"
LLDAP__LDAP_USER_PASS="/run/secrets/lldap_admin_password"
LLDAP__DATABASE_URL="/run/secrets/lldap_db_url"
LLDAP__SMTP_OPTIONS__ENABLE_PASSWORD_RESET="true"
# NONE, TLS or STARTTLS
LLDAP__SMTP_OPTIONS__SMTP_ENCRYPTION="TLS"
LLDAP__SMTP_OPTIONS__FROM="SabNet-Auth <admin@${DOMAINNAME}>"
LLDAP__SMTP_OPTIONS__TO="admin <admin@${DOMAINNAME}>"

###MEALIE### https://github.com/mealie-recipes/mealie
MEALIE__NAME="mealie"
MEALIE__SUBDOMAIN="mealie"
MEALIE__IMAGE="ghcr.io/mealie-recipes/mealie"
MEALIE__VERSION="v3.19.2"
# Local sign-up off; new users come through Authelia (OIDC_SIGNUP_ENABLED).
MEALIE__ALLOW_SIGNUP="false"
MEALIE__ALLOW_PASSWORD_LOGIN="false"
# TLS, SSL or NONE
MEALIE__SMTP_AUTH_STRATEGY="SSL"
MEALIE__SMTP_FROM_NAME="Mealie"
MEALIE__SMTP_FROM_EMAIL="mealie@${DOMAINNAME}"
MEALIE__POSTGRES_USER="mealie"
MEALIE__POSTGRES_DB="mealie"
MEALIE__POSTGRES_PASSWORD_FILE="/run/secrets/mealie_db_password"
MEALIE__OIDC_AUTH_ENABLED="true"
MEALIE__OIDC_PROVIDER_NAME="authelia"
MEALIE__OIDC_CONFIGURATION_URL="https://${AUTHELIA__SUBDOMAIN}.${DOMAINNAME}/.well-known/openid-configuration"
MEALIE__OIDC_CLIENT_ID_FILE="/run/secrets/mealie_oidc_client_id"
MEALIE__OIDC_CLIENT_SECRET_FILE="/run/secrets/mealie_oidc_client_secret"
MEALIE__OIDC_SIGNUP_ENABLED="true"
MEALIE__OIDC_ADMIN_GROUP="admin"
MEALIE__OIDC_USER_GROUP="user"
# Skip Mealie's login page and go straight to Authelia.
MEALIE__OIDC_AUTO_REDIRECT="true"
MEALIE__OIDC_REMEMBER_ME="true"
# Theme: light mode
MEALIE__THEME_LIGHT_PRIMARY="#D97C96"
MEALIE__THEME_LIGHT_ACCENT="#E891A7"
MEALIE__THEME_LIGHT_SECONDARY="#C86C88"
MEALIE__THEME_LIGHT_SUCCESS="#4CAF50"
MEALIE__THEME_LIGHT_INFO="#2196F3"
MEALIE__THEME_LIGHT_WARNING="#FFC107"
MEALIE__THEME_LIGHT_ERROR="#dd7171"
# Theme: dark mode
MEALIE__THEME_DARK_PRIMARY="#C2185B"
MEALIE__THEME_DARK_ACCENT="#FF80AB"
MEALIE__THEME_DARK_SECONDARY="#AD1457"
MEALIE__THEME_DARK_SUCCESS="#81C784"
MEALIE__THEME_DARK_INFO="#64B5F6"
MEALIE__THEME_DARK_WARNING="#FFD54F"
MEALIE__THEME_DARK_ERROR="#E57373"

###MOUSEHOLE### https://github.com/t-mart/mousehole
MOUSEHOLE__NAME="mousehole"
# At <subdomain>.int.<domain>
MOUSEHOLE__SUBDOMAIN="${MOUSEHOLE__NAME}"
MOUSEHOLE__IMAGE="tmmrtn/mousehole"
MOUSEHOLE__VERSION="0.3.1"
MOUSEHOLE__ALLOWED_HOST="${MOUSEHOLE__SUBDOMAIN}.int.${DOMAINNAME}"
MOUSEHOLE__ALLOWED_ORIGINS="${MOUSEHOLE__SUBDOMAIN}.int.${DOMAINNAME}/*"
MOUSEHOLE__HTTPS_ONLY_COOKIES="true"

###MOUSETRAP### https://github.com/sirjmann92/mousetrap
MOUSETRAP__NAME="mousetrap"
# At <subdomain>.int.<domain>
MOUSETRAP__SUBDOMAIN="${MOUSETRAP__NAME}"
MOUSETRAP__IMAGE="ghcr.io/sirjmann92/mousetrap"
MOUSETRAP__VERSION="2.3.66"
MOUSETRAP__LOGLEVEL="INFO"

###PGADMIN### https://github.com/pgadmin-org/pgadmin4
PGADMIN__NAME="postgres-web"
# At <subdomain>.int.<domain>, logged in from Authelia's Remote-User.
PGADMIN__SUBDOMAIN="pg"
# Data folder (its name differs from the container's).
PGADMIN__VOLDIR="${VOLDIR}/pgadmin"
PGADMIN__IMAGE="dpage/pgadmin4"
PGADMIN__VERSION="9.18.0"
PGADMIN__DEFAULT_EMAIL="admin@${DOMAINNAME}"
# 9.18+ listens on 8080 under no-new-privileges (it can't bind 80).
PGADMIN__PORT="8080"

###POSTGRES### https://hub.docker.com/r/tensorchord/vchord-postgres
# Shared by Authelia, LLDAP, Immich, Vaultwarden, Mealie, FreshRSS,
# Linkwarden and Chaptarr (each with its own database and user).
POSTGRESQL__NAME="postgres"
POSTGRESQL__IMAGE="tensorchord/vchord-postgres"
POSTGRESQL__VERSION="pg18-v1.1.1"
POSTGRESQL__HOST="postgres"
POSTGRESQL__PORT="5432"
POSTGRESQL__DB_NAME="postgres"
POSTGRESQL__PASSWORD_FILE="/run/secrets/postgres_password"
POSTGRESQL__INITDB_ARGS="--encoding=UTF8 --locale=C"

###PROWLARR### https://github.com/linuxserver/docker-prowlarr
PROWLARR__NAME="prowlarr"
# At <subdomain>.int.<domain>
PROWLARR__SUBDOMAIN="prowlarr"
PROWLARR__IMAGE="lscr.io/linuxserver/prowlarr"
PROWLARR__VERSION="2.4.0"

###FLARESOLVERR### https://github.com/FlareSolverr/FlareSolverr
# Used by Prowlarr; goes out through the VPN's HTTP proxy.
FLARESOLVERR__NAME="flaresolverr"
FLARESOLVERR__VOLDIR="${VOLDIR}/prowlarr/flaresolverr"
FLARESOLVERR__IMAGE="ghcr.io/flaresolverr/flaresolverr"
FLARESOLVERR__VERSION="v3.5.0"

###QBITTORRENT### https://github.com/linuxserver/docker-qbittorrent
# Runs inside the VPN container's network; torrent port is in SITE.
QBITTORRENT__NAME="qbittorrent"
# At <subdomain>.int.<domain>
QBITTORRENT__SUBDOMAIN="q"
QBITTORRENT__IMAGE="lscr.io/linuxserver/qbittorrent"
QBITTORRENT__VERSION="5.2.1"
QBITTORRENT__WEBUI_PORT="8080"

###REDIS### https://github.com/valkey-io/valkey
# Immich's Valkey (no password; reachable by Immich only). Authelia has its
# own (compose/authelia-redis) using the same image.
REDIS__NAME="redis"
REDIS__IMAGE="docker.io/valkey/valkey"
REDIS__VERSION="8-bookworm@sha256:a137a2b60aca1a75130022d6bb96af423fefae4eb55faf395732db3544803280"

###SOCKET-PROXY### https://github.com/linuxserver/docker-socket-proxy
SOCKET_PROXY__NAME="socket-proxy"
SOCKET_PROXY__RO_NAME="socket-proxy-ro"
SOCKET_PROXY__IMAGE="lscr.io/linuxserver/socket-proxy"
SOCKET_PROXY__VERSION="3.2.19"

###TRAEFIK### https://github.com/traefik/traefik
TRAEFIK__NAME="traefik"
# Dashboard, at <subdomain>.int.<domain> behind Authelia.
TRAEFIK__SUBDOMAIN="traefik"
TRAEFIK__IMAGE="traefik"
TRAEFIK__VERSION="v3.7.14"
TRAEFIK__CF_DNS_API_TOKEN_FILE="/run/secrets/traefik_cloudflare_dns_api_token"
# Let's Encrypt account e-mail (expiry notices).
TRAEFIK__ACME_EMAIL="hosting@${DOMAINNAME}"
# Traefik's own log level: DEBUG, INFO, WARN, ERROR.
TRAEFIK__LOG_LEVEL="INFO"

###VAULTWARDEN### https://github.com/dani-garcia/vaultwarden
# Admin token: secrets/vaultwarden/admin_token (argon2 hash), set in vaultwarden.yaml.
VAULTWARDEN__NAME="vaultwarden"
VAULTWARDEN__SUBDOMAIN="vw"
VAULTWARDEN__IMAGE="vaultwarden/server"
VAULTWARDEN__VERSION="1.37.1"
VAULTWARDEN__DOMAIN="https://${VAULTWARDEN__SUBDOMAIN}.${DOMAINNAME}"
VAULTWARDEN__WEBSOCKET_ENABLED="true"
VAULTWARDEN__SIGNUPS_ALLOWED="false"
VAULTWARDEN__SMTP_FROM="vaultwarden@${DOMAINNAME}"
VAULTWARDEN__PUSH_ENABLED="true"
VAULTWARDEN__PUSH_RELAY_URI="https://api.bitwarden.eu"
VAULTWARDEN__PUSH_IDENTITY_URI="https://identity.bitwarden.eu"
VAULTWARDEN__PUSH_INSTALLATION_ID_FILE="/run/secrets/vaultwarden_push_installation_id"
VAULTWARDEN__PUSH_INSTALLATION_KEY_FILE="/run/secrets/vaultwarden_push_installation_key"
VAULTWARDEN__EXTENDED_LOGGING="false"
VAULTWARDEN__USE_SYSLOG="false"
VAULTWARDEN__DATABASE_URL_FILE="/run/secrets/vaultwarden_db_url"
VAULTWARDEN__SSO_ENABLED="true"
VAULTWARDEN__SSO_AUTHORITY="https://${AUTHELIA__SUBDOMAIN}.${DOMAINNAME}"
VAULTWARDEN__SSO_SCOPES="openid profile email offline_access"
VAULTWARDEN__SSO_CLIENT_ID_FILE="/run/secrets/vaultwarden_oidc_client_id"
VAULTWARDEN__SSO_CLIENT_SECRET_FILE="/run/secrets/vaultwarden_oidc_client_secret"
VAULTWARDEN__SSO_ALLOW_UNKNOWN_EMAIL_VERIFICATION="false"
VAULTWARDEN__SSO_SIGNUPS_MATCH_EMAIL="true"
VAULTWARDEN__SSO_CLIENT_CACHE_EXPIRATION="0"

###VPN### https://github.com/qdm12/gluetun
# Provider and countries are in SITE.
VPN__NAME="vpn"
VPN__IMAGE="qmcgaw/gluetun"
VPN__VERSION="v3.41.3"
VPN__TYPE="wireguard"
VPN__WIREGUARD_PRIVATE_KEY_FILE="/run/secrets/vpn_wireguard_private_key"
VPN__WIREGUARD_PRESHARED_KEY_FILE="/run/secrets/vpn_wireguard_preshared_key"
VPN__WIREGUARD_ADDRESSES_FILE="/run/secrets/vpn_wireguard_addresses"
# Gluetun's FIREWALL_OUTBOUND_SUBNETS: everything else leaves via the tunnel
# or not at all. socket_proxy_ro is for Mousetrap's port monitor.
VPN__EXTERNAL_SUBNETS="${SUBNET_EXTERNAL},${SUBNET_SOCKET_PROXY_RO}"
VPN__PROXY_URL="http://vpn:8888"

###WATCHTOWER### https://github.com/nicholas-fedor/watchtower
# (disabled in compose.yaml; replaced by Diun)
WATCHTOWER__NAME="watchtower"
WATCHTOWER__IMAGE="nickfedor/watchtower"
WATCHTOWER__VERSION="1.18"
